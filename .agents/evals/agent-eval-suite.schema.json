{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbital-inspect.local/schemas/agent-eval-suite.schema.json",
  "title": "Orbital Inspect Agent Eval Suite",
  "type": "object",
  "required": ["version", "suite_id", "name", "evals"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/eval"
      }
    }
  },
  "$defs": {
    "eval": {
      "type": "object",
      "required": ["id", "title", "category", "critical", "rationale", "graders"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "authority",
            "fail_closed",
            "privacy",
            "workflow",
            "nasa_spacex_readiness",
            "llm_output",
            "offline_eval",
            "ci"
          ]
        },
        "critical": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "graders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/grader"
          }
        }
      }
    },
    "grader": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file_contains",
            "file_not_contains",
            "file_regex",
            "json_field_equals",
            "command"
          ]
        },
        "path": {
          "type": "string"
        },
        "contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field": {
          "type": "string"
        },
        "equals": {},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "expected_exit": {
          "type": "integer",
          "default": 0
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    }
  }
}
